{
  "rewrites": [
    {
      "source": "/app/:path*",
      "destination": "/app/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/app/:path*"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/automations",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/purge-email-html",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/cotisation-status-sweep",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/membership-drafts-sweep",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/boutique-storefront-sweep",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/custom-domain-verification-sweep",
      "schedule": "*/15 * * * *"
    }
  ]
}
