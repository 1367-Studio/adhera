  associationId  String
  fournisseurId  String?
  number         String
  status         DevisStatus @default(BROUILLON)
  issueDate      DateTime    @default(now())
  validUntil     DateTime?
  subtotal       Decimal     @db.Decimal(10, 2)
  vatAmount      Decimal     @default(0) @db.Decimal(10, 2)
  discountAmount Decimal     @default(0) @db.Decimal(10, 2)
  total          Decimal     @db.Decimal(10, 2)
  notes          String?
  paymentTerms   String?
  pdfUrl         String?
  sentAt         DateTime?
  respondedAt    DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  deletedAt      DateTime?

  association Association  @relation(fields: [associationId], references: [id], onDelete: Cascade)
  fournisseur Fournisseur? @relation(fields: [fournisseurId], references: [id])
  items       DevisItem[]
  facture     Facture?

  @@unique([associationId, number])
  @@index([associationId, status])
  @@index([associationId, deletedAt])
}

model DevisItem {
  id          String  @id @default(cuid())
  devisId     String
  description String
  quantity    Decimal @db.Decimal(10, 2)
  unitPrice   Decimal @db.Decimal(10, 2)
  vatRate     Decimal @default(0) @db.Decimal(5, 2)
  discount    Decimal @default(0) @db.Decimal(10, 2)
  order       Int     @default(0)

  devis Devis @relation(fields: [devisId], references: [id], onDelete: Cascade)

  @@index([devisId])
}

enum FactureStatus {
  BROUILLON
  EN_ATTENTE
  PARTIELLEMENT_PAYEE
  PAYEE
  EN_RETARD
  ANNULEE
}

model Facture {
  id             String        @id @default(cuid())
  associationId  String
  fournisseurId  String?
  devisId        String?       @unique
  materialLoanId String?       @unique
  number         String
  status         FactureStatus @default(BROUILLON)
  issueDate      DateTime      @default(now())
  dueDate        DateTime?
  subtotal       Decimal       @db.Decimal(10, 2)
  vatAmount      Decimal       @default(0) @db.Decimal(10, 2)
  discountAmount Decimal       @default(0) @db.Decimal(10, 2)
  total          Decimal       @db.Decimal(10, 2)
  amountPaid     Decimal       @default(0) @db.Decimal(10, 2)
  notes          String?
  paymentTerms   String?
  pdfUrl         String?
  sentAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  association  Association      @relation(fields: [associationId], references: [id], onDelete: Cascade)
  fournisseur  Fournisseur?     @relation(fields: [fournisseurId], references: [id])
  devis        Devis?           @relation(fields: [devisId], references: [id])
  materialLoan MaterialLoan?    @relation(fields: [materialLoanId], references: [id], onDelete: SetNull)
  items        FactureItem[]
  payments     FacturePayment[]

  @@unique([associationId, number])
  @@index([associationId, status])
  @@index([associationId, dueDate])
  @@index([associationId, deletedAt])
}

model FactureItem {
  id          String  @id @default(cuid())
  factureId   String
  description String
  quantity    Decimal @db.Decimal(10, 2)
  unitPrice   Decimal @db.Decimal(10, 2)
  vatRate     Decimal @default(0) @db.Decimal(5, 2)
  discount    Decimal @default(0) @db.Decimal(10, 2)
  order       Int     @default(0)

  facture Facture @relation(fields: [factureId], references: [id], onDelete: Cascade)

  @@index([factureId])
}

model FacturePayment {
  id        String   @id @default(cuid())
  factureId String
  amount    Decimal  @db.Decimal(10, 2)
  method    String
  paidAt    DateTime @default(now())
  note      String?
  createdAt DateTime @default(now())

  facture Facture @relation(fields: [factureId], references: [id], onDelete: Cascade)
  income  Income?

  @@index([factureId, paidAt])
}

enum FactureRecueStatus {
  A_PAYER
  PAYEE
  EN_LITIGE
  ANNULEE
}

model FactureRecue {
  id            String             @id @default(cuid())
  associationId String
  fournisseurId String?
  number        String?
  type          String // facture | devis_recu | comprovante | contrat | autre
  issueDate     DateTime
  amount        Decimal            @db.Decimal(10, 2)
  status        FactureRecueStatus @default(A_PAYER)
  fileUrl       String
  notes         String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  deletedAt     DateTime?

  association Association  @relation(fields: [associationId], references: [id], onDelete: Cascade)
  fournisseur Fournisseur? @relation(fields: [fournisseurId], references: [id])
  expense     Expense?

  @@index([associationId, status])
  @@index([associationId, deletedAt])
}

// Azure Translator cache — keyed by content hash so identical text (even across
// associations) is translated once per locale and reused until the source text changes.
model Translation {
  hash       String
  locale     String
  translated String   @db.Text
  createdAt  DateTime @default(now())

  @@id([hash, locale])
}
