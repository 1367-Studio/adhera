enum BoutiqueCommandeSource {
  STOREFRONT
  MEMBERSHIP_FORM
  EVENEMENT
}

model BoutiqueCommande {
  id                    String                 @id @default(cuid())
  associationId         String
  membreId              String?
  guestName             String?
  guestEmail            String?
  status                BoutiqueCommandeStatus @default(PENDING)
  paymentMethod         BoutiquePaymentMethod  @default(MANUAL)
  manualPaymentType     BoutiquePaymentMethod?
  // STOREFRONT (défaut, historique) = vente créée depuis le module Boutique lui-même
  // (dashboard ou /api/portal/boutique/checkout). MEMBERSHIP_FORM = vente rattachée à une
  // adhésion via MembershipFormProduct — même stock, même liste de commandes, juste une
  // origine différente pour pouvoir filtrer/reporter dessus.
  source                BoutiqueCommandeSource @default(STOREFRONT)
  // Renseigné uniquement pour source = MEMBERSHIP_FORM — traçabilité vers l'adhésion qui a
  // accompagné cet achat. SetNull (pas Cascade) : supprimer la Cotisation ne doit pas
  // supprimer une vente déjà comptabilisée (Income déjà émis).
  cotisationId          String?
  // Même principe que cotisationId, pour source = EVENEMENT — traçabilité vers le billet qui
  // a accompagné cet achat. SetNull, même raisonnement.
  participationId       String?
  // Assigned once, the moment the commande first becomes PAID — never reassigned by the
  // manualPaymentType correction flow, so a reçu already handed to a buyer keeps its number.
  receiptNumber         String?
  // Set once, the same moment as receiptNumber — kept separate from `updatedAt` because the
  // manualPaymentType correction flow updates the row after payment and must not make an
  // old sale look like it happened today (receipt PDF date, "Ventes récentes" ordering).
  paidAt                DateTime?
  stripePaymentIntentId String?
  totalAmount           Int
  note                  String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  association Association            @relation(fields: [associationId], references: [id], onDelete: Cascade)
  membre      Membre?                @relation(fields: [membreId], references: [id], onDelete: SetNull)
  cotisation  Cotisation?            @relation(fields: [cotisationId], references: [id], onDelete: SetNull)
  participation Participation?       @relation(fields: [participationId], references: [id], onDelete: SetNull)
  items       BoutiqueCommandeItem[]

  @@unique([associationId, receiptNumber])
  @@index([associationId, status])
}

model BoutiqueCommandeItem {
  id         String  @id @default(cuid())
  commandeId String
  produitId  String
  varianteId String
  // Snapshot of BoutiqueProduit.categoryId taken when the item was ordered — recategorizing
  // a product later must not retroactively change how an already-placed order gets booked
  // to Finances once it's encaissé.
  categoryId String?
  quantity   Int
  unitPrice  Int

  commande BoutiqueCommande @relation(fields: [commandeId], references: [id], onDelete: Cascade)
  produit  BoutiqueProduit  @relation(fields: [produitId], references: [id], onDelete: Restrict)
  variante BoutiqueVariante @relation(fields: [varianteId], references: [id], onDelete: Restrict)
  category FinanceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
}

// ─── Réunions ─────────────────────────────────────────────────────────────────

model Meeting {
  id               String        @id @default(cuid())
  associationId    String
  title            String
  description      String?
  status           MeetingStatus @default(SCHEDULED)
  type             MeetingType   @default(GENERALE)
  scheduledAt      DateTime?
  startedAt        DateTime?
  endedAt          DateTime?
  roomName         String        @unique
  createdById      String
  transcript       String?
  summary          String?
  shareToken       String?       @unique
  shareExpiresAt   DateTime?
  // Snapshot of whichever LiveKit account (platform or the association's own) actually
  // created this meeting's room, pinned on first use — later changes to the association's
  // LiveKit settings must not point an in-progress/already-created meeting at a different
  // account than the one its room actually lives on.
  livekitUrl       String?
  livekitApiKey    String?
  livekitApiSecret String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  association  Association          @relation(fields: [associationId], references: [id], onDelete: Cascade)
  participants MeetingParticipant[]
  recordings   MeetingRecording[]

  @@index([associationId])
}

model MeetingParticipant {
  id        String    @id @default(cuid())
  meetingId String
  membreId  String
  joinedAt  DateTime?

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  membre  Membre  @relation(fields: [membreId], references: [id], onDelete: Cascade)

  @@unique([meetingId, membreId])
}

// One row per participant's own audio recording — a meeting recorded this way produces
// several files instead of one merged mix, so each transcript segment can later be
// attributed to whoever actually said it (see Phase 1 of the meeting-transcript-export work).
model MeetingRecording {
  id           String    @id @default(cuid())
  meetingId    String
  // Matches the LiveKit participant identity issued when they joined: the raw userId for
  // dashboard admins/managers, or "membre-{id}" for portal members (see token routes).
  identity     String
  displayName  String
  egressId     String
  recordingKey String?
  startedAt    DateTime  @default(now())
  endedAt      DateTime?

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
}

