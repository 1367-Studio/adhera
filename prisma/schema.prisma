enum EmailStatus {
  QUEUED
  SENT
  DELIVERED
  OPENED
  CLICKED
  BOUNCED
  COMPLAINED
  DELAYED
  FAILED
}

model EmailMessage {
  id             String      @id @default(cuid())
  associationId  String
  membreId       String?
  // Set when the recipient is a manager/staff account (User) rather than a Membre —
  // e.g. Support-sent emails (source "SUPPORT_MESSAGE") can target either.
  userId         String?
  resendId       String?     @unique
  to             String
  subject        String
  // Full rendered HTML, kept so the admin email log can show what was actually sent —
  // not reconstructible after the fact since templates are re-rendered with live data.
  html           String?     @db.Text
  // Attachments (e.g. Devis/Facture PDFs) aren't part of `html` and so never show up in
  // the admin preview — this flags that gap instead of letting the preview look complete.
  hasAttachments Boolean     @default(false)
  // "SONDAGE" | "AUTOMATION" | "BULK_MESSAGE" | "MEMBER_INVITE" | "MEETING_INVITE" |
  // "TRANSACTION" | "DOCUMENT" | "TEST" | "SUPPORT_MESSAGE" — kept as a String (not enum)
  // so new sources don't need a migration, matching the MessageTemplate.category convention.
  source         String
  sourceId       String?
  status         EmailStatus @default(QUEUED)
  errorMessage   String?
  sentAt         DateTime?
  deliveredAt    DateTime?
  openedAt       DateTime?
  clickedAt      DateTime?
  bouncedAt      DateTime?
  complainedAt   DateTime?
  createdAt      DateTime    @default(now())

  association Association @relation(fields: [associationId], references: [id], onDelete: Cascade)
  membre      Membre?     @relation(fields: [membreId], references: [id], onDelete: SetNull)
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([associationId, membreId, createdAt(sort: Desc)])
  @@index([associationId, source, createdAt(sort: Desc)])
  @@index([source, sourceId])
}

enum SmsStatus {
  QUEUED
  SENDING
  SENT
  DELIVERED
  UNDELIVERED
  FAILED
}

model SmsMessage {
  id            String    @id @default(cuid())
  associationId String
  membreId      String?
  twilioSid     String?   @unique
  to            String
  body          String    @db.Text
  // "BULK_MESSAGE" | "AUTOMATION" | "COTISATION_REMINDER" — String not enum, same
  // convention as EmailMessage.source (new sources shouldn't need a migration).
  source        String
  sourceId      String?
  status        SmsStatus @default(QUEUED)
  errorMessage  String?
  sentAt        DateTime?
  deliveredAt   DateTime?
  failedAt      DateTime?
  createdAt     DateTime  @default(now())

  association Association @relation(fields: [associationId], references: [id], onDelete: Cascade)
  membre      Membre?     @relation(fields: [membreId], references: [id], onDelete: SetNull)

  @@index([associationId, membreId, createdAt(sort: Desc)])
  @@index([source, sourceId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
}

