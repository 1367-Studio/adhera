generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  ADMIN
  PRESIDENT
  TRESORIER
  SECRETAIRE
  MEMBRE
}

enum MembreStatus {
  PENDING
  ACTIF
  INACTIF
  SUSPENDU
}

enum CotisationStatus {
  EN_ATTENTE
  PARTIELLEMENT_PAYEE
  PAYE
  EN_RETARD
  EXONERE
  ANNULEE
}

enum RsvpStatus {
  CONFIRME
  PROVAVEL
  INCERTO
  ABSENT
  // Événement (ou tarif) complet au moment de l'inscription, avec Evenement.waitlistEnabled
  // actif — jamais compté dans les requêtes d'occupation existantes (qui ne filtrent que sur
  // CONFIRME), donc automatiquement hors capacité sans changement de requête. Ne passe jamais
  // par Stripe tant qu'elle reste à ce statut — voir inscription/route.ts.
  LISTA_ESPERA
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  CANCELLED
  PAST_DUE
  SUSPENDED
}

// Drives the member limit and which modules default on (see src/lib/plan-limits.ts,
// src/lib/modules.ts) — independent from which Stripe Price actually bills the
// association. Associations created before the Essentiel/Pro split keep billing on the
// original single-product Price (STRIPE_PRICE_MONTHLY/YEARLY) but still get tagged
// ESSENTIAL/PRO here based on their member count (see scripts/migrate-existing-
// associations-to-tier.ts) so limits/features behave consistently for everyone.
enum AssociationPlan {
  ESSENTIAL
  PRO
}

// Status of a staff-generated custom-pricing signup link (see PricingOffer) — PENDING
// until redeemed through /register?offer=<token>, EXPIRED/REVOKED close the link without
// ever redeeming it.
enum PricingOfferStatus {
  PENDING
  USED
  EXPIRED
  REVOKED
}

enum MaterialStatus {
  DISPONIBLE
  EN_USE
  EN_MAINTENANCE
  HORS_SERVICE
  PERDU
}

enum LoanStatus {
  DEMANDE
  CONFIRME
  REFUSE
}

enum TriggerType {
  SCHEDULED_ONCE
  SCHEDULED_RECURRING
  EVENT_COTISATION_DUE
  EVENT_PAYMENT_OVERDUE
  EVENT_REMINDER
  RSVP_CONFIRMED
  MEMBER_CREATED
  MEMBER_BIRTHDAY
  EVENT_ADHERENT_LAPSED
}

enum MessageChannel {
  EMAIL
  SMS
  BOTH
}

enum RuleStatus {
  ACTIVE
  PAUSED
  DONE
}

enum SondageStatus {
  BROUILLON
  ACTIF
  FERME
}

enum BoutiqueProduitStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum BoutiqueCommandeStatus {
  PENDING
  PAID
  CANCELLED
}

enum BoutiquePaymentMethod {
  STRIPE
  MANUAL
  ESPECES
  CHEQUE
  CB
  VIREMENT
}

enum MeetingStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

enum MeetingType {
  AG
  BUREAU
  GENERALE
}

enum QuestionType {
  TEXT_SHORT
  TEXT_LONG
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  RATING
  YES_NO
}

enum BankTransactionType {
  CREDIT
  DEBIT
}

// Which header/portal a notification's link points into — lets the bell filter its list to
// what's relevant in the current context, instead of a gestão user clicking one and getting
// bounced into the member portal (or vice versa) with no warning.
enum NotificationScope {
  MEMBRE
  GESTION
}

enum SupportTicketStatus {
  OUVERT
  FERME
}

enum ExerciceStatus {
  OUVERT
  CLOTURE
}

enum BankTransactionStatus {
  UNMATCHED
  MATCHED
  PENDING
  IGNORED
  DUPLICATE
}

enum FinanceCategoryType {
  INCOME
  EXPENSE
}

enum IncomeSource {
  MANUAL
  STRIPE
  BANK_IMPORT
}

enum IncomeStatus {
  PENDING
  PAID
  CANCELLED
}

enum ExpenseStatus {
  DRAFT
  VALIDATED
  CANCELLED
}

enum MatchedBy {
  AUTO
  USER
}

enum DonorType {
  INDIVIDUAL
  COMPANY
}

// Null on every Don predating this field (all Stripe, paidAt only ever written by the
// webhook until offline methods existed) — treated as STRIPE by the UI, never backfilled.
enum DonPaymentMethod {
  STRIPE
  ESPECES
  CHEQUE
  VIREMENT
}

// Catégories de l'organisme bénéficiaire cochées sur les Cerfa 11580 (2041-RD) et
// 16216 (2041-MEC-SD) — union des deux listes, utilisée pour l'attestation imprimée
// sur le reçu fiscal entreprise.
enum OrganismeCategory {
  ASSOCIATION_LOI_1901
  FONDATION_RECONNUE_UTILITE_PUBLIQUE
  FONDATION_UNIVERSITAIRE_PARTENARIALE
  FONDATION_ENTREPRISE
  MUSEE_DE_FRANCE
  AIDE_ALIMENTAIRE_SOCIALE
  AUTRE_INTERET_GENERAL
  ASSOCIATION_CULTUELLE_ALSACE_MOSELLE
  ETABLISSEMENT_ENSEIGNEMENT_SUPERIEUR
  ETABLISSEMENT_ENSEIGNEMENT_SUPERIEUR_CONSULAIRE
  ORGANISME_RECHERCHE_SCIENTIFIQUE
  ORGANISME_SPECTACLE_EXPOSITIONS
  PROJET_THESE_DOCTORAT
  SOCIETE_EXPOSITIONS_UNIVERSELLES
  SOCIETE_PROGRAMME_AUDIOVISUEL
  FONDATION_PATRIMOINE
  FONDS_DOTATION
  ORGANISME_AIDE_PME
  FEDERATION_ORGANISMES_AGREES
  ORGANISME_PROTECTION_BIENS_CULTURELS
  ORGANISME_UE_SIMILAIRE
}

enum Civilite {
  MME
  MLLE
  M
}

enum GroupeSanguin {
  A_POSITIF
  A_NEGATIF
  B_POSITIF
  B_NEGATIF
  AB_POSITIF
  AB_NEGATIF
  O_POSITIF
  O_NEGATIF
}

enum Sexe {
  HOMME
  FEMME
}

enum TailleTshirt {
  XS
  S
  M
  L
  XL
  XXL
  XXXL
}

enum DonationFormStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum DonationFieldRequirement {
  HIDDEN
  OPTIONAL
  REQUIRED
}

enum DonationFieldType {
  TEXT
  NUMBER
}

enum DonationTierKind {
  ONE_OFF
  RECURRING
}

enum DonationInterval {
  MONTH
  QUARTER
  YEAR
}

enum DonationReceiptMode {
  NONE
  FULL
  PARTIAL
}

enum DonationVisibility {
  LINK
  SITE
  PRIVATE
}

enum DonationSubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum CotisationSubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum MembershipFormStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum MembershipFieldRequirement {
  HIDDEN
  OPTIONAL
  REQUIRED
}

enum MembershipFieldType {
  TEXT
  NUMBER
}

enum MembershipTierKind {
  ONE_OFF
  RECURRING
}

// MEMBERSHIP defines the resulting Membre's duration/status (exactly what MembershipTier
// already did before this enum existed) — exactly one MEMBERSHIP tier is selected per
// checkout. ADDON and DONATION are optional extras selectable alongside it: ADDON produces a
// MembershipAddonPurchase, DONATION produces a real Don (Don.membreId/donationFormId/tierId
// are already nullable — see Don model — so this needs no changes there).
enum MembershipTierItemType {
  MEMBERSHIP
  ADDON
  DONATION
}

enum MembershipVisibility {
  LINK
  SITE
  PRIVATE
}

enum MembershipValidationMode {
  IMMEDIATE
  REQUEST
}

// ─── Models ───────────────────────────────────────────────────────────────────

model Association {
  id                             String             @id @default(cuid())
  name                           String
  slug                           String             @unique
  city                           String?
  country                        String             @default("France")
  address                        String?
  phone                          String?
  website                        String?
  // Shown on devis/facture PDFs (below "Conditions de paiement") so the recipient knows
  // where to wire payment — distinct from BankAccount, which is for reconciliation import
  // and only ever stores a last-4, never a full IBAN.
  iban                           String?
  bic                            String?
  siren                          String?
  rna                            String?
  canIssueTaxReceipts            Boolean            @default(false)
  // Null = don't auto-create a cotisation on member creation. When set, a Cotisation
  // (EN_ATTENTE, current year) is created automatically for every new Membre — see
  // src/lib/cotisation-defaults.ts — so they can pay it themselves from the portal right
  // away instead of waiting on an admin to create one.
  cotisationDefaultAmount        Decimal?           @db.Decimal(10, 2)
  // Off by default so turning it on is a deliberate choice, separate from
  // cotisationDefaultAmount's original purpose above — when true, the public site's
  // membership form (SiteMembershipSection) requires immediate payment via a recurring
  // Stripe subscription instead of creating a PENDING request for manual approval. See
  // CotisationSubscription and /api/public/[slug]/inscription/checkout.
  publicMembershipPaymentEnabled Boolean            @default(false)
  objet                          String?
  organismeCategory              OrganismeCategory  @default(ASSOCIATION_LOI_1901)
  organismeCategoryDetail        String?
  // "groq" | "openai" | "mistral" — see src/lib/ai/client.ts SUPPORTED_PROVIDERS. Null
  // means the association hasn't configured BYOK yet (falls back to the platform's Groq
  // key, see platformClient in the same file).
  aiProvider                     String?
  aiApiKey                       String?
  aiModel                        String?
  smsAccountSid                  String?
  smsAuthToken                   String?
  smsPhoneNumber                 String?
  livekitUrl                     String?
  livekitApiKey                  String?
  livekitApiSecret               String?
  stripeCustomerId               String?
  stripeSubscriptionId           String?
  // Set only when the subscription was created via a PricingOffer (custom staff-negotiated
  // phased pricing) instead of the standard PLAN_PRICES catalog — informational/for
  // backoffice display only. The webhook sync (customer.subscription.*) keys off
  // stripeSubscriptionId as always, regardless of whether a Schedule manages it.
  stripeSubscriptionScheduleId   String?
  stripeConnectId                String?
  plan                           AssociationPlan    @default(ESSENTIAL)
  // Staff-set override for negotiated "sur mesure" deals (see form-wise-app's pricing
  // page) — plan stays ESSENTIAL/PRO (still what Stripe actually bills), this just raises
  // the member cap enforced by assertMemberLimit() past what that tier normally allows.
  // Null means "use the tier's standard limit", not "unlimited".
  customMemberLimit              Int?
  // Brand identity applied to the dashboard, portal, devis/facture PDFs and the feuille
  // de présence PDF — separate from siteConfig's own logoUrl/primaryColor, which only
  // exist once the association has set up its public site. logoUrl/primaryColor also
  // seed the site builder's fields the first time it's opened.
  logoUrl                        String?
  // No DB default on purpose — a bare column default made every Pro association look
  // branded in this color (dashboard/portal theme, PDFs, emails) before the admin ever
  // opened the branding settings. null means "use the platform's own default theme";
  // the site builder and branding-settings UI supply #6366f1 as their own form default
  // instead, only persisted once the admin actually saves.
  primaryColor                   String?
  secondaryColor                 String?
  // Custom branding (logo + colors) defaults to Pro-only — see canUseCustomBranding() in
  // src/lib/plan-limits.ts. Same override pattern as customMemberLimit: null/false uses
  // the plan default, true force-enables it for an Essentiel association.
  customBrandingEnabled          Boolean?
  subscriptionStatus             SubscriptionStatus @default(TRIAL)
  trialEndsAt                    DateTime?
  // Stamped by the Stripe webhook when a card-free trial (see /api/register) reached its
  // end with still no payment method on file and Stripe cancelled the subscription — as
  // opposed to an admin resigning. Drives the "Essai terminé" wording on the standby and
  // re-subscribe screens instead of the generic "Abonnement résilié"; cleared as soon as
  // the association is back on a live subscription.
  trialExpiredAt                 DateTime?
  suspendedAt                    DateTime?
  cancelAtPeriodEnd              Boolean            @default(false)
  currentPeriodEndsAt            DateTime?
  sitePublished                  Boolean            @default(false)
  siteConfig                     Json?
  modules                        Json?
  internalNotes                  String?
  createdAt                      DateTime           @default(now())
  updatedAt                      DateTime           @updatedAt
  deletedAt                      DateTime?

  users                      User[]
  membres                    Membre[]
  membreTypes                MembreType[]
  evenements                 Evenement[]
  cotisations                Cotisation[]
  actualites                 Actualite[]
  messageTemplates           MessageTemplate[]
  automationRules            AutomationRule[]
  materials                  Material[]
  activityLogs               ActivityLog[]
  dons                       Don[]
  donationForms              DonationForm[]
  donationSubscriptions      DonationSubscription[]
  cotisationSubscriptions    CotisationSubscription[]
  cotisationInstallmentPlans CotisationInstallmentPlan[]
  membershipForms            MembershipForm[]
  membershipAddonPurchases   MembershipAddonPurchase[]
  membershipCheckoutDrafts   MembershipCheckoutDraft[]
  sondages                   Sondage[]
  boutiqueProduits           BoutiqueProduit[]
  boutiqueCommandes          BoutiqueCommande[]
  meetings                   Meeting[]
  exercicesComptables        ExerciceComptable[]
  bankAccounts               BankAccount[]
  bankTransactions           BankTransaction[]
  financeCategories          FinanceCategory[]
  incomes                    Income[]
  expenses                   Expense[]
  bankReconciliations        BankReconciliation[]
  fournisseurs               Fournisseur[]
  devis                      Devis[]
  factures                   Facture[]
  facturesRecues             FactureRecue[]
  emailMessages              EmailMessage[]
  smsMessages                SmsMessage[]
  supportTickets             SupportTicket[]
  pricingOffer               PricingOffer?
}

// A staff-generated, single-use custom-pricing signup link (see /register?offer=<token>)
// — the "caso a caso" alternative to the fixed PLAN_PRICES catalog, for negotiated deals
// like a discounted phase followed by a recurring price. Not a reusable named plan: one
// row is redeemed by exactly one new Association, then closed for good.
model PricingOffer {
  id    String @id @default(cuid())
  token String @unique

  // Internal note for staff (e.g. "Cliente X — lançamento"), never shown to the person
  // redeeming the link — the public lookup route only returns phases/label-free data.
  label String

  // Which Formwise tier this association gets tagged as once redeemed (member limits,
  // module gating — see plan-limits.ts) — independent of the custom Stripe price, same
  // decoupling as Association.customMemberLimit.
  planTier AssociationPlan

  // OfferPhase[] — see src/lib/pricing-offers.ts. Only the last phase may have
  // months: null (open-ended/recurring forever).
  phases Json

  // One Stripe Product shared by every phase of this offer, created once when the offer
  // itself is created (not at redemption time) — see createOfferProduct().
  stripeProductId String

  status    PricingOfferStatus @default(PENDING)
  expiresAt DateTime?
  usedAt    DateTime?

  associationId String?      @unique
  association   Association? @relation(fields: [associationId], references: [id])

  createdByUserId String
  createdBy       User   @relation(fields: [createdByUserId], references: [id])

  createdAt DateTime @default(now())

  @@index([status])
}

model User {
  id              String    @id @default(cuid())
  email           String
  name            String?
  passwordHash    String
  role            UserRole  @default(MEMBRE)
  active          Boolean   @default(true)
  locale          String    @default("fr")
  // Ordered array of DashboardWidgetId strings (see src/lib/dashboard-widgets.ts) —
  // null means "never customized", resolved to the default order in app code via
  // parseDashboardLayout(), same shape as Association.modules falling back to
  // DEFAULT_MODULES via parseModules().
  dashboardLayout Json?
  associationId   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  // Set once, at signup, when the account is created via /register (see
  // src/lib/consent.ts and src/app/api/register/route.ts) — null for accounts created
  // any other way (admin-created members, portal self-registration) since those don't
  // go through the paid-signup consent step. termsVersion lets us know exactly which
  // revision of the CGS/politique de confidentialité was in effect when they agreed.
  termsAcceptedAt         DateTime?
  termsVersion            String?
  termsAcceptedIp         String?
  fiscalPeriodPopupSeenAt DateTime?

  association           Association?           @relation(fields: [associationId], references: [id])
  notifications         Notification[]
  membre                Membre?
  passwordResetTokens   PasswordResetToken[]
  supportTickets        SupportTicket[]
  supportTicketMessages SupportTicketMessage[]
  emailMessages         EmailMessage[]
  pricingOffersCreated  PricingOffer[]

  @@unique([email, associationId])
  @@index([associationId, role])
}

model MembreType {
  id            String   @id @default(cuid())
  name          String
  description   String?
  color         String   @default("gray")
  associationId String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  association     Association      @relation(fields: [associationId], references: [id])
  membres         Membre[]
  membershipTiers MembershipTier[]

  @@unique([name, associationId])
}

model Membre {
  id               String         @id @default(cuid())
  firstName        String
  lastName         String
  email            String?
  phone            String?
  birthDate        DateTime?
  address          String?
  civilite         Civilite?
  groupeSanguin    GroupeSanguin?
  sexe             Sexe?
  allergies        String?
  photoUrl         String?
  // Not defaulted to "fr" the way User.locale is — null means "never asked", not "assumed
  // French". Set explicitly by an admin/the member themselves, or auto-captured from the
  // page's own locale on a public signup form (the visitor already picked it via
  // LocaleSwitcher there, so there's no separate input for it — see checkout/route.ts).
  // Not yet read by any email-sending code; captured now for that future use.
  preferredLocale  String?
  // Langue parlée (code ISO 639-1, liste dans src/lib/languages.ts) — distinct de
  // preferredLocale, qui est la langue de l'interface/des e-mails. Saisie par l'admin,
  // par le membre sur le portail, ou sur un MembershipForm quand fieldLanguage l'expose.
  spokenLanguage   String?
  possedeTshirt    Boolean?
  tailleTshirt     TailleTshirt?
  status           MembreStatus   @default(ACTIF)
  // Tri-state manual override of "adhérent" status: null = automatic (computed from the
  // current-year Cotisation, see src/lib/membre-adherent.ts), true = force adhérent, false =
  // force bénévole. Defaults to null so a new member is not automatically an adhérent.
  adherentOverride Boolean?
  typeId           String?
  responsableId    String?
  associationId    String
  userId           String?        @unique
  joinedAt         DateTime       @default(now())
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deletedAt        DateTime?

  // Set on the public membership-request form (src/components/site/sections/site-
  // membership-section.tsx), which creates a PENDING Membre with no User/password yet —
  // there's no User row to stamp consent on at that point, unlike the other signup flows
  // (see User.termsAcceptedAt). Left null for members created any other way (admin-added,
  // portal self-registration — those stamp the User instead).
  termsAcceptedAt DateTime?
  termsVersion    String?
  termsAcceptedIp String?

  // Réponses aux MembershipFormField du MembershipForm utilisé à l'inscription, keyed by
  // field id (plus la clé fixe "mobile" — birthDate/sexe ont leurs propres colonnes
  // ci-dessus) — même convention que Don.answers. Vit sur le profil (pas sur la Cotisation)
  // car une personne ne s'inscrit comme membre qu'une fois, contrairement à un don qui se
  // répète par transaction.
  answers Json?

  // ID stable du contact dans le système source d'un import (ex: "ID contact" AssoConnect)
  // — survit à un changement de nom/email entre deux exports du même client, contrairement
  // au matching par email+nom utilisé en fallback quand ce champ est absent. Voir
  // src/app/api/membres/import/route.ts.
  externalId String?

  // Tarif gratuit demandé par un PENDING issu d'un MembershipForm en validation "sur
  // demande" — lu une seule fois par PATCH /api/membres/[id] quand un admin fait passer ce
  // membre en ACTIF, pour créer automatiquement la Cotisation EXONERE correspondante, puis
  // remis à null. Reste null pour un PENDING créé par n'importe quelle autre voie (ancien
  // flux /inscription, etc.) — celles-là gardent leur comportement actuel, sans cotisation
  // auto-créée à l'approbation.
  pendingTierId String?

  association              Association               @relation(fields: [associationId], references: [id])
  user                     User?                     @relation(fields: [userId], references: [id])
  type                     MembreType?               @relation(fields: [typeId], references: [id])
  pendingTier              MembershipTier?           @relation(fields: [pendingTierId], references: [id], onDelete: SetNull)
  responsable              Membre?                   @relation("MembreResponsable", fields: [responsableId], references: [id], onDelete: SetNull)
  dependants               Membre[]                  @relation("MembreResponsable")
  cotisations              Cotisation[]
  participations           Participation[]
  actualiteRecipients      ActualiteRecipient[]
  materialLoans            MaterialLoan[]
  automationLogs           AutomationLog[]
  dons                     Don[]
  membershipAddonPurchases MembershipAddonPurchase[]
  sondageRecipients        SondageRecipient[]
  sondageReponses          SondageReponse[]
  boutiqueCommandes        BoutiqueCommande[]
  meetingsAsParticipant    MeetingParticipant[]
  incomes                  Income[]
  emailMessages            EmailMessage[]
  smsMessages              SmsMessage[]
  cotisationSubscription   CotisationSubscription?

  @@index([associationId, deletedAt])
  @@index([associationId, status])
  @@index([associationId, externalId])
}

model Evenement {
  id                     String                    @id @default(cuid())
  title                  String
  description            String?
  imageUrl               String?
  date                   DateTime
  endDate                DateTime?
  location               String?
  lat                    Float?
  lng                    Float?
  price                  Decimal?                  @db.Decimal(10, 2)
  capacity               Int?
  // Optionnel — un admin doit explicitement le renseigner pour recevoir un email à chaque
  // inscription à cet événement (voir notifyEventRegistration). Miroir exact de
  // MembershipForm.adminNotificationEmail. Sans ce champ, une inscription ne produit qu'une
  // notification in-app pour les gestionnaires — jamais rien d'envoyé par email.
  adminNotificationEmail String?
  // Contact affiché aux visiteurs sur la page publique de l'événement — jamais utilisé pour
  // recevoir quoi que ce soit en interne, contrairement à adminNotificationEmail ci-dessus.
  // Miroir exact de MembershipForm/DonationForm.contactEmail/contactPhone.
  contactEmail           String?
  contactPhone           String?
  qrToken                String?                   @unique
  qrExpiresAt            DateTime?
  // Étape "Publication" du wizard (miroir MembershipForm.status) — DRAFT tant que l'admin
  // configure l'événement, PUBLISHED une fois partagé, ARCHIVED pour le retirer sans supprimer
  // l'historique des inscriptions. Backfill à PUBLISHED pour toute ligne créée avant ce champ :
  // tout événement existant était déjà public via son lien depuis toujours.
  status                 EvenementStatus           @default(DRAFT)
  // Étape "Paiement" — mêmes 3 méthodes hors-ligne que MembershipForm/DonationForm, réutilisant
  // Participation.paymentMethod/ticketPaidAt comme suivi d'encaissement (voir ce champ).
  allowCash              Boolean                   @default(false)
  allowCheque            Boolean                   @default(false)
  allowTransfer          Boolean                   @default(false)
  offlineInstructions    String?
  confirmationMessage    String?
  // Étape "Formulaire" — matrice d'exigence pour les champs non-custom, miroir de
  // MembershipForm.fieldPhone/fieldAddress/fieldBirthDate/fieldGender/fieldMobile. Backfill
  // de fieldPhone/fieldAddress à OPTIONAL (pas HIDDEN) : ces deux champs sont déjà affichés-
  // mais-facultatifs sur tout événement existant — OPTIONAL est la seule valeur qui préserve
  // ce comportement à l'identique. Les 3 nouveaux (birthDate/gender/mobile) n'ont jamais été
  // collectés avant ce champ, donc HIDDEN (leur default) est le backfill correct pour eux.
  fieldPhone             EvenementFieldRequirement @default(OPTIONAL)
  fieldAddress           EvenementFieldRequirement @default(OPTIONAL)
  fieldBirthDate         EvenementFieldRequirement @default(HIDDEN)
  fieldGender            EvenementFieldRequirement @default(HIDDEN)
  fieldMobile            EvenementFieldRequirement @default(HIDDEN)
  // Étape "Publication" — miroir MembershipForm.visibility/opensAt/closesAt, sans SITE : la
  // section "événements" du site liste déjà tout événement publié automatiquement par date,
  // sans binding par événement (contrairement à un MembershipForm qui choisit sa propre
  // SiteSection) — voir Decisão de design #2 du plan.
  visibility             EvenementVisibility       @default(LINK)
  opensAt                DateTime?
  closesAt               DateTime?
  // Miroir exact de MembershipForm/DonationForm.conditions/attachments/requireCguvSignature —
  // absents de tout événement existant avant ce champ (backfill : conditions/attachments
  // null, requireCguvSignature false, son default de colonne = comportement identique à avant).
  conditions             String? // HTML riche
  attachments            Json? // [{ url, filename, size }]
  requireCguvSignature   Boolean                   @default(false)
  // Opt-in — false par défaut : certains organisateurs veulent un blocage dur à la capacité,
  // pas une file d'attente. Quand actif, une inscription qui dépasserait la capacité (de
  // l'événement ou d'une tarif) est acceptée avec rsvp = LISTA_ESPERA au lieu d'être rejetée
  // — voir inscription/route.ts.
  waitlistEnabled        Boolean                   @default(false)
  associationId          String
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt

  association    Association            @relation(fields: [associationId], references: [id])
  participations Participation[]
  actualites     Actualite[]
  customFields   EvenementCustomField[]
  ticketTypes    EvenementTicketType[]
  dons           Don[]
  avis           EvenementAvis[]
  products       EvenementProduct[]
  discountCodes  EvenementDiscountCode[]

  @@index([associationId, date])
  @@index([associationId, status])
}

enum EvenementStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EvenementVisibility {
  LINK
  PRIVATE
}

enum EvenementFieldRequirement {
  HIDDEN
  OPTIONAL
  REQUIRED
}

// Miroir de DonPaymentMethod/paymentMethod du Don — null veut dire Stripe (toute ligne
// existante avant ce champ, et toute ligne payée en ligne pour toujours) ; une valeur explicite
// veut dire que le participant a choisi un règlement hors-ligne à l'inscription, en attente
// d'encaissement (Participation.ticketPaidAt reste null jusqu'à confirmation admin).
enum EvenementPaymentMethod {
  STRIPE
  ESPECES
  CHEQUE
  VIREMENT
}

enum EvenementFieldType {
  TEXT
  NUMBER
  // Uploaded via the anonymous, event-scoped route in
  // src/app/api/public/[slug]/evenements/[id]/upload/route.ts — the answer stored in
  // Participation.answers is the resulting R2 URL, not raw file data.
  FILE
  LONG_TEXT
  DATE
  // SELECT/RADIO/CHECKBOX_MULTI all read their choice list from `options` below — same
  // storage, different input widget. SELECT/RADIO answers are a single string (must be one
  // of `options`); CHECKBOX_MULTI answers are a JSON string array (each entry must be one
  // of `options`) — see Participation.answers's own comment for the encoding.
  SELECT
  RADIO
  CHECKBOX_MULTI
  // Answer stored as the literal string "true"/"false" — never "1"/"" — so it reads
  // unambiguously in admin display/exports.
  BOOLEAN
}

// Admin-defined extra fields on an event's public registration form (name/type/order),
// answered per Participation via Participation.answers — see that field's comment.
model EvenementCustomField {
  id          String             @id @default(cuid())
  evenementId String
  type        EvenementFieldType
  label       String
  required    Boolean            @default(false)
  order       Int
  // Choice list for SELECT/RADIO/CHECKBOX_MULTI — a plain string array, e.g. ["S","M","L"].
  // Null/ignored for every other type.
  options     Json?

  evenement Evenement @relation(fields: [evenementId], references: [id], onDelete: Cascade)

  @@index([evenementId])
}

// Optional per-event list of ticket price tiers (e.g. "Gratuit" 0€, "Tarif réduit" 2,5€) that a
// registrant picks from on the public/portal registration form, instead of Evenement.price's
// single flat amount. Additive: an event with zero rows here behaves exactly as before, driven
// entirely by Evenement.price — price is only ignored once at least one tier exists.
// TICKET = tarif normal, un seul choisi par participant (comportement historique, avant ce
// champ — backfill à TICKET pour toute ligne existante). DONATION = extra optionnel coché en
// plus du billet, montant libre avec `price` comme minimum — mirroir de
// MembershipTier.itemType, voir src/lib/webhook/evenement-addons.ts.
enum EvenementTicketTypeItemType {
  TICKET
  DONATION
}

model EvenementTicketType {
  id                  String                      @id @default(cuid())
  evenementId         String
  itemType            EvenementTicketTypeItemType @default(TICKET)
  label               String
  price               Decimal                     @db.Decimal(10, 2)
  // Prix affiché barré à côté de `price` quand renseigné, purement cosmétique — confirmé en
  // direct sur AssoConnect ("Prix avant réduction") : aucune logique de choix pour le
  // participant, le montant réellement facturé reste `price`. Null = comportement identique
  // à avant ce champ.
  priceBeforeDiscount Decimal?                    @db.Decimal(10, 2)
  capacity            Int? // null = unlimited, same convention as Evenement.capacity
  order               Int
  // Reçu fiscal — miroir exact de MembershipTier/DonationTier.receiptMode/ineligibleAmount.
  // Backfill à NONE : aucun billet n'a jamais émis de reçu avant ce champ, et NONE est le
  // default de colonne, donc aucune tarif existant ne change de comportement. Pour
  // itemType == DONATION, seuls NONE/FULL sont acceptés (pas PARTIAL) — même contrainte que
  // MembershipTier pour une tarif DONATION.
  receiptMode         DonationReceiptMode         @default(NONE)
  ineligibleAmount    Decimal?                    @db.Decimal(10, 2)
  // Cache une tarifa du formulaire public sans la supprimer — l'historique de qui s'est déjà
  // inscrit dessus reste intact. Miroir du recurso "Afficher cette formule lors de
  // l'inscription" de l'AssoConnect, qui est déjà une simple checkbox binaire — pas la peine
  // d'un enum à 3 états façon BoutiqueProduitStatus, une tarif n'a pas d'état "brouillon".
  active              Boolean                     @default(true)
  // Fenêtre de vente propre à cette tarif, en plus de celle de l'événement entier
  // (Evenement.opensAt/closesAt) — null = toujours ouverte tant que l'événement l'est. Ne
  // peut que restreindre davantage, jamais ouvrir au-delà de la fenêtre de l'événement (voir
  // le double-check dans inscription/route.ts).
  opensAt             DateTime?
  closesAt            DateTime?

  evenement      Evenement       @relation(fields: [evenementId], references: [id], onDelete: Cascade)
  participations Participation[]
  donsGenerated  Don[]

  @@index([evenementId])
}

enum EvenementDiscountKind {
  FIXED
  PERCENT
}

// Code promotionnel scopé à un seul événement — aucune équivalent côté AssoConnect (son propre
// "réduction" est juste le prix barré cosmétique de EvenementTicketType.priceBeforeDiscount,
// voir le commentaire de ce champ) : construit sans précédent externe à imiter, sur demande du
// Leandro. Ne s'applique jamais aux tarifs DONATION (déjà un "montant libre") ni aux produits
// Boutique/dons embarqués — seulement au prix du billet, voir inscription/route.ts.
model EvenementDiscountCode {
  id          String                @id @default(cuid())
  evenementId String
  // Toujours comparé en majuscules (normalisé à l'écriture et à la lecture) — jamais une
  // contrainte de collation DB, pour rester portable.
  code        String
  kind        EvenementDiscountKind
  // FIXED = montant en euros retiré du prix ; PERCENT = pourcentage (0-100) retiré du prix.
  value       Decimal               @db.Decimal(10, 2)
  startsAt    DateTime?
  endsAt      DateTime?
  maxUses     Int?
  usesCount   Int                   @default(0)
  active      Boolean               @default(true)
  // Vide = s'applique à toutes les tarifs TICKET de l'événement. Sinon, liste d'ids
  // EvenementTicketType — jamais validé par une FK (simple tableau de strings, comme
  // BoutiqueCommandeItem.varianteId ailleurs) car une tarif supprimée ne doit pas faire
  // disparaître le code, juste cesser de s'y appliquer.
  ticketTypeIds String[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  evenement Evenement @relation(fields: [evenementId], references: [id], onDelete: Cascade)
  participations Participation[]

  @@unique([evenementId, code])
  @@index([evenementId])
}

model Participation {
  id                String                  @id @default(cuid())
  membreId          String? // null = convive sans compte membre
  evenementId       String
  firstName         String // capturé sur la ligne — pas de join Membre pour l'affichage
  lastName          String
  email             String?
  phone             String?
  address           String?
  birthDate         DateTime?
  gender            Sexe?
  // Réponses aux EvenementCustomField de cet événement, keyed by field id (ex: {"clxyz...": "42"})
  // — un JSON simple suffit ici, personne n'agrège ces réponses entre participants comme un sondage.
  // La valeur est une string pour tout type sauf CHECKBOX_MULTI, qui stocke un vrai tableau
  // JSON de strings (jamais une string séparée par virgules — casserait si une option
  // contenait elle-même une virgule).
  // Porte aussi la clé fixe "mobile" (mobile phone n'a pas de colonne dédiée) — même
  // convention que Membre.answers pour fieldMobile côté adhésion.
  answers           Json?
  present           Boolean                 @default(false)
  rsvp              RsvpStatus?
  rsvpAt            DateTime?
  ticketPaidAt      DateTime?
  amount            Decimal?                @db.Decimal(10, 2) // montant payé pour CETTE place
  orderId           String? // regroupe les places d'une même réservation/paiement
  stripeSessionId   String?
  // Which EvenementTicketType this seat picked, when the event has tiers — null for
  // untiered/flat-price/free events (the vast majority). Drives the per-seat amount at checkout
  // time instead of Evenement.price.
  ticketTypeId      String?
  // Code promo appliqué à ce billet, le cas échéant — snapshot pour traçabilité, jamais
  // recalculé après coup. `amount` ci-dessus porte déjà le prix réduit ; ce champ ne sert qu'à
  // savoir QUEL code a servi (utile pour l'incrémentation atomique de usesCount côté webhook
  // Stripe, et pour l'affichage admin). onDelete SetNull : supprimer un code ne doit jamais
  // faire disparaître une inscription déjà passée.
  discountCodeId    String?
  // Null = payé en ligne par Stripe (toute ligne d'avant ce champ, pour toujours) — une valeur
  // explicite veut dire que le participant a choisi ce moyen hors-ligne à l'inscription (voir
  // EvenementPaymentMethod). ticketPaidAt reste null jusqu'à ce qu'un admin confirme
  // l'encaissement via le même flux "marquer payé" que les entrées manuelles.
  paymentMethod     EvenementPaymentMethod?
  // Dénormalisé depuis evenement.associationId — nécessaire pour la numérotation des reçus par
  // association/année (même contrainte que Cotisation/Don/BoutiqueCommande, voir nextNumber).
  associationId     String
  // Snapshot de EvenementTicketType.receiptMode/ineligibleAmount au moment du paiement — pas
  // recalculé après coup, même raisonnement que Cotisation.receiptMode : un admin qui modifie
  // la tarif plus tard ne doit pas changer rétroactivement le reçu d'un billet déjà payé.
  receiptMode       DonationReceiptMode?
  deductibleAmount  Decimal?                @db.Decimal(10, 2)
  receiptNumber     String?
  receiptIssuedAt   DateTime?
  // Lien d'auto-annulation envoyé par email — uniquement pour les inscriptions publiques
  // (membreId null), qui n'ont pas de compte portail pour utiliser le flux authentifié.
  cancelToken       String?                 @unique
  // Jeton du billet, encodé dans le QR code envoyé par email après inscription/paiement.
  // Scanné à l'entrée par l'organisateur (présences → scanner) pour valider le billet et
  // marquer la présence — voir /api/evenements/[id]/scan. Null pour les rows antérieures
  // à la fonctionnalité (pas de backfill : leur email est déjà parti sans QR).
  ticketToken       String?                 @unique
  // Lien public (sans compte) pour laisser un avis après l'événement — même principe que
  // cancelToken/ticketToken. Généré à l'envoi de l'email de demande d'avis (voir le cron
  // Inngest event-review-request), pas à l'inscription.
  reviewToken       String?                 @unique
  // Dédoublonne l'envoi automatique de l'email de demande d'avis — le cron tourne tous les
  // jours et ne doit relancer l'email qu'une seule fois par participation.
  reviewRequestedAt DateTime?
  // Preuve de consentement quand Evenement.requireCguvSignature est actif — posée
  // server-side à l'inscription, jamais reprise du client seul. Null quand l'événement ne
  // l'exige pas. Miroir exact de Don.cguvAgreedAt/Cotisation.cguvAgreedAt.
  cguvAgreedAt      DateTime?
  // Nom complet saisi par le participant comme preuve informelle de signature, à côté de la
  // case à cocher — même niveau de rigueur, juste avec un nom capturé. N'existe nulle part
  // ailleurs dans Adhera aujourd'hui (voir le plan) : les autres formulaires (Dons/Adhésions)
  // n'ont qu'une case à cocher, pas de champ nom dédié.
  signedName        String?
  createdAt         DateTime                @default(now())

  membre         Membre?              @relation(fields: [membreId], references: [id])
  evenement      Evenement            @relation(fields: [evenementId], references: [id])
  ticketType     EvenementTicketType? @relation(fields: [ticketTypeId], references: [id])
  discountCode   EvenementDiscountCode? @relation(fields: [discountCodeId], references: [id], onDelete: SetNull)
  incomes        Income[]
  automationLogs AutomationLog[]
  avis           EvenementAvis?
  boutiqueCommandes BoutiqueCommande[]

  @@unique([associationId, receiptNumber])
  @@index([evenementId])
  @@index([orderId])
  @@index([membreId, evenementId])
}

// Avis laissé par un participant après un événement — une note (1-5) et un commentaire
// facultatif. Un seul avis par participation (participationId unique), seuls les
// participants marqués présents peuvent en laisser un (vérifié côté API, pas ici).
model EvenementAvis {
  id              String   @id @default(cuid())
  evenementId     String
  participationId String   @unique
  rating          Int
  comment         String?
  createdAt       DateTime @default(now())

  evenement     Evenement     @relation(fields: [evenementId], references: [id], onDelete: Cascade)
  participation Participation @relation(fields: [participationId], references: [id], onDelete: Cascade)

  @@index([evenementId])
}

model Cotisation {
  id                  String              @id @default(cuid())
  membreId            String
  associationId       String
  amount              Decimal             @db.Decimal(10, 2)
  amountPaid          Decimal             @default(0) @db.Decimal(10, 2)
  year                Int
  paidAt              DateTime?
  dueDate             DateTime?
  status              CotisationStatus    @default(EN_ATTENTE)
  note                String?
  stripeSessionId     String?
  // Lien de paiement public « réglez de votre côté » — même convention que
  // Participation.cancelToken : un token 160 bits envoyé par email suffit, pas de compte
  // requis. Posé à la création par maybeCreateDefaultCotisation ; null pour les rows
  // antérieures ou créées ailleurs (webhooks, admin manuel).
  paymentToken        String?             @unique
  declarationNumber   String?
  declarationIssuedAt DateTime?
  // The real, tax-deductible "reçu fiscal" (CERFA) — distinct from declarationNumber above,
  // which is a non-deductible attestation always available for any PAYE cotisation. This one
  // only exists when receiptMode is not NONE (see below) and the association has
  // canIssueTaxReceipts — mirrors Don.receiptNumber/receiptIssuedAt exactly, and shares the
  // same per-association/per-year numbering sequence (see assignReceiptNumber in
  // src/lib/pdf/recu-fiscal.ts) so no two receipts — Don or Cotisation — ever collide.
  receiptNumber       String?
  receiptIssuedAt     DateTime?
  lastReminderSentAt  DateTime?
  // Set when this year's cotisation was produced by a recurring Stripe charge (see
  // CotisationSubscription) rather than a one-off/manual payment — mirrors Don.subscriptionId.
  subscriptionId      String?
  // Reporting-only link to whichever MembershipForm/MembershipTier produced this cotisation
  // (one-off or the first year of a recurring one) — mirrors Don.donationFormId/tierId. Null
  // for cotisations created any other way (admin manual add, legacy /inscription flow).
  membershipFormId    String?
  tierId              String?
  // Snapshotted from MembershipTier.receiptMode/ineligibleAmount at creation — never re-derived
  // if the tier changes afterward, same reasoning as membershipFormId/tierId already being
  // frozen copies. Governs whether this Cotisation can ever get a receiptNumber above (and, if
  // PARTIAL, which amount that receipt shows — see receiptAmount() in recu-fiscal.ts) —
  // unrelated to declarationNumber, which every PAYE cotisation can get regardless.
  receiptMode         DonationReceiptMode @default(NONE)
  deductibleAmount    Decimal?            @db.Decimal(10, 2)
  // Set only when this Cotisation came from a custom-duration MembershipTier (see
  // MembershipTier.durationMonths) — null for the ordinary calendar-year row, where validity
  // is implicitly Jan 1–Dec 31 of `year`. periodEnd, when set, is what src/lib/membre-
  // adherent.ts actually checks instead of `year` to decide if this row still covers today.
  periodStart         DateTime?
  periodEnd           DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  membre            Membre                     @relation(fields: [membreId], references: [id])
  association       Association                @relation(fields: [associationId], references: [id])
  payments          CotisationPayment[]
  installments      CotisationInstallment[]
  subscription      CotisationSubscription?    @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  membershipForm    MembershipForm?            @relation(fields: [membershipFormId], references: [id], onDelete: SetNull)
  tier              MembershipTier?            @relation(fields: [tierId], references: [id], onDelete: SetNull)
  addonPurchases    MembershipAddonPurchase[]
  installmentPlan   CotisationInstallmentPlan?
  boutiqueCommandes BoutiqueCommande[]

  @@unique([membreId, year])
  @@unique([associationId, declarationNumber])
  @@unique([associationId, receiptNumber])
  @@index([associationId, status])
  @@index([subscriptionId])
  @@index([membershipFormId])
  @@index([tierId])
}

// Le pendant "N fois puis stop" de CotisationSubscription (qui, elle, se renouvelle
// indéfiniment) — un Stripe Subscription plafonné à installmentsCount cycles via
// subscription_data.cancel_at (voir checkout/route.ts), dont CHAQUE prélèvement s'applique à
// la MÊME Cotisation via recordCotisationPayment (src/lib/webhook/membership-installments.ts),
// contrairement à handleCotisationInvoicePaid qui crée une nouvelle Cotisation par an.
model CotisationInstallmentPlan {
  id                   String   @id @default(cuid())
  associationId        String
  cotisationId         String   @unique
  stripeSubscriptionId String   @unique
  stripeCustomerId     String
  // Self-service cancellation link, same convention as CotisationSubscription.cancelToken —
  // emailed on a failed installment charge (see membershipInstallmentPaymentFailedEmail), not
  // proactively at signup, mirroring how the recurring-membership flow already only surfaces
  // its own cancel link reactively rather than in the welcome email.
  cancelToken          String?  @unique
  installmentsCount    Int
  installmentsPaid     Int      @default(0)
  // ACTIVE tant que Stripe continue de prélever ; COMPLETED une fois les installmentsCount
  // prélèvements reçus ; CANCELLED si annulé avant terme (échec de paiement épuisant les
  // relances Stripe, ou annulation manuelle) — jamais réécrit en CANCELLED une fois COMPLETED,
  // voir handleMembershipInstallmentDeleted.
  status               String   @default("ACTIVE")
  createdAt            DateTime @default(now())

  association Association @relation(fields: [associationId], references: [id], onDelete: Cascade)
  cotisation  Cotisation  @relation(fields: [cotisationId], references: [id], onDelete: Cascade)

  @@index([associationId])
}

model CotisationInstallment {
  id           String   @id @default(cuid())
  cotisationId String
  amount       Decimal  @db.Decimal(10, 2)
  dueDate      DateTime
  order        Int      @default(0)

  cotisation Cotisation @relation(fields: [cotisationId], references: [id], onDelete: Cascade)

  @@index([cotisationId])
}

model CotisationPayment {
  id           String   @id @default(cuid())
  cotisationId String
  amount       Decimal  @db.Decimal(10, 2)
  method       String
  paidAt       DateTime @default(now())
  note         String?
  createdAt    DateTime @default(now())

  cotisation Cotisation @relation(fields: [cotisationId], references: [id], onDelete: Cascade)
  income     Income?

  @@index([cotisationId, paidAt])
}

model Don {
  id                    String               @id @default(cuid())
  associationId         String
  membreId              String?
  evenementId           String?
  donorType             DonorType            @default(INDIVIDUAL)
  firstName             String
  lastName              String
  companyName           String?
  siret                 String?
  email                 String
  address               String?
  amount                Decimal              @db.Decimal(10, 2)
  message               String?
  anonymous             Boolean              @default(false)
  receiptNumber         String?
  receiptIssuedAt       DateTime?
  stripeSessionId       String?              @unique
  paidAt                DateTime?
  refundedAt            DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  // Null for the standalone donation page (/portal/[slug]/don) — a Don only carries these
  // when it came through a configurable DonationForm. Additive: existing rows are unaffected.
  donationFormId        String?
  tierId                String?
  // Set only on the Don produced by a recurring donation's successful charge (invoice.paid) —
  // null for one-off dons, whether via a DonationForm or the standalone page.
  subscriptionId        String?
  // Set only when this Don was the embedded-donation extra on a MembershipForm signup (see
  // MembershipTier.itemType == DONATION, src/lib/webhook/membership-addons.ts). Distinct from
  // `tierId` above, which points at the unrelated DonationTier model — a donation bought this
  // way never has a DonationTier, so `tierId` stays null and this field carries the link
  // instead. Without it, nothing traces this Don back to the MembershipTier that produced it:
  // membre-detail-view.tsx can't show it next to the member's other adhésion purchases, and
  // the tiers API can't tell a still-referenced DONATION tier from an unused one before
  // allowing its itemType to change or the tier to be deleted.
  membershipAddonTierId String?
  // Même principe que membershipAddonTierId ci-dessus, mais côté Eventos : rempli quand ce Don
  // vient d'une tarif de type DONATION cochée pendant l'inscription à un événement (voir
  // EvenementTicketType.itemType, src/lib/webhook/evenement-addons.ts). Distinct de
  // `evenementId` ci-dessus, qui reste utilisé par le prompt de don *après* inscription — les
  // deux flux coexistent, celui-ci trace uniquement le don embarqué dans le même paiement que
  // le billet.
  evenementTicketTypeId String?
  // Réponses aux DonationFormField du formulaire, keyed by field id — même convention que
  // Participation.answers.
  answers               Json?
  // Null = Stripe (the only method before offline donations existed). Set explicitly for
  // ESPECES/CHEQUE/VIREMENT — those are the only ones where paidAt isn't written by the
  // webhook, see the "encaissement" flow in /api/dons/[id]/encaisser.
  paymentMethod         DonPaymentMethod?
  // Proof of consent when the form's requireCguvSignature is on — set server-side at
  // checkout, never trusted from the client alone. Null when the form doesn't require it.
  cguvAgreedAt          DateTime?
  // Snapshotted from DonationTier at the moment this Don is created — same reasoning as
  // `amount` already being its own column instead of being re-read from the tier. Without
  // this, an admin editing a tier's receiptMode/ineligibleAmount between "donor gave a
  // cheque" and "admin confirms it arrived" (which can be days) silently changes what
  // receipt gets issued, contradicting what the donor was shown on the public page. Null
  // for the standalone /portal/[slug]/don page (no tier) — receiptMode null there means
  // "always full", matching the pre-existing behavior.
  receiptMode           DonationReceiptMode?
  deductibleAmount      Decimal?             @db.Decimal(10, 2)

  association         Association           @relation(fields: [associationId], references: [id])
  membre              Membre?               @relation(fields: [membreId], references: [id])
  // A donation prompted by an event registration is still a standalone association-level
  // donation record — this is only a reporting link, so deleting the event must not delete it.
  evenement           Evenement?            @relation(fields: [evenementId], references: [id], onDelete: SetNull)
  donationForm        DonationForm?         @relation(fields: [donationFormId], references: [id], onDelete: SetNull)
  tier                DonationTier?         @relation(fields: [tierId], references: [id], onDelete: SetNull)
  subscription        DonationSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  // SetNull, not Cascade — a Don is a real financial/receipt record and must survive even if
  // the MembershipTier that generated it is later deleted (unlike MembershipAddonPurchase,
  // which is a lightweight purchase log with no receipt of its own).
  membershipAddonTier MembershipTier?       @relation(fields: [membershipAddonTierId], references: [id], onDelete: SetNull)
  // SetNull, même raisonnement que membershipAddonTier — le Don doit survivre à la
  // suppression de la tarif qui l'a produit.
  evenementTicketType EvenementTicketType?  @relation(fields: [evenementTicketTypeId], references: [id], onDelete: SetNull)

  @@unique([associationId, receiptNumber])
  @@index([associationId, paidAt])
  @@index([evenementId])
  @@index([membreId])
  @@index([donationFormId])
  @@index([subscriptionId])
  @@index([membershipAddonTierId])
  @@index([evenementTicketTypeId])
}

// Formulaire de don configurable — remplace le modèle « une page de don par association »
// par N formulaires par association, chacun avec son slug/visuel/paliers/règles. Additif :
// les dons de la page autonome (Don.donationFormId null) continuent d'exister sans lui.
model DonationForm {
  id            String             @id @default(cuid())
  associationId String
  slug          String
  title         String
  status        DonationFormStatus @default(DRAFT)

  // Étape 1 — Informations générales
  imageUrl             String?
  description          String? // HTML riche
  conditions           String? // HTML riche
  attachments          Json? // [{ url, filename, size }]
  requireCguvSignature Boolean @default(false)
  contactEmail         String?
  contactPhone         String?

  // Étape 3 — Formulaire : matrice d'exigence des champs standards
  fieldAddress   DonationFieldRequirement @default(HIDDEN)
  fieldBirthDate DonationFieldRequirement @default(HIDDEN)
  fieldPhone     DonationFieldRequirement @default(HIDDEN)
  fieldMobile    DonationFieldRequirement @default(HIDDEN)
  fieldGender    DonationFieldRequirement @default(HIDDEN)

  // Étape 4 — Paiement
  allowOnline         Boolean @default(true)
  allowCash           Boolean @default(false)
  allowCheque         Boolean @default(false)
  allowTransfer       Boolean @default(false)
  offlineInstructions String?
  confirmationMessage String?

  // Étape 5 — Publication
  visibility DonationVisibility @default(LINK)
  opensAt    DateTime?
  closesAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  association   Association            @relation(fields: [associationId], references: [id], onDelete: Cascade)
  tiers         DonationTier[]
  customFields  DonationFormField[]
  dons          Don[]
  subscriptions DonationSubscription[]

  @@unique([associationId, slug])
  @@index([associationId, status])
}

// Palier tarifaire d'un DonationForm — ponctuel ou récurrent. Même rôle qu'EvenementTicketType,
// avec la même propriété additive.
model DonationTier {
  id     String           @id @default(cuid())
  formId String
  order  Int
  kind   DonationTierKind @default(ONE_OFF)

  freeAmount Boolean           @default(false) // « Montant libre »
  // Montant fixe du palier ; si freeAmount, sert de montant minimum optionnel (null =
  // aucun minimum, seul le plancher générique MIN_DONATION_AMOUNT s'applique).
  amount     Decimal?          @db.Decimal(10, 2)
  interval   DonationInterval? // requis si kind = RECURRING

  label            String
  receiptMode      DonationReceiptMode @default(FULL)
  // Part du montant NON éligible au reçu fiscal (ex. valeur d'une contrepartie reçue en
  // échange) — requis si receiptMode = PARTIAL. Le montant éligible imprimé sur le reçu est
  // calculé automatiquement (voir eligibleReceiptAmount dans src/lib/receipt-eligibility.ts)
  // comme (montant réellement payé − ineligibleAmount), jamais stocké tel quel : pour un
  // palier freeAmount le montant payé n'est connu qu'au moment du paiement.
  ineligibleAmount Decimal?            @db.Decimal(10, 2)

  form          DonationForm           @relation(fields: [formId], references: [id], onDelete: Cascade)
  dons          Don[]
  subscriptions DonationSubscription[]

  @@index([formId])
}

// Champ personnalisé par formulaire, répondu via Don.answers — même mécanisme
// qu'EvenementCustomField / Participation.answers.
model DonationFormField {
  id       String            @id @default(cuid())
  formId   String
  type     DonationFieldType
  label    String
  required Boolean           @default(false)
  order    Int

  form DonationForm @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId])
}

// Formulaire d'adhésion configurable — même rôle que DonationForm mais le checkout produit
// un Membre/Cotisation/CotisationSubscription au lieu d'un Don. Additif : le flux public fixe
// existant (Association.cotisationDefaultAmount/publicMembershipPaymentEnabled, voir
// /api/public/[slug]/inscription) continue de fonctionner tel quel pour les associations qui
// n'ont créé aucun MembershipForm — la section site préfère un formulaire PUBLISHED+SITE s'il
// en existe un, sinon retombe sur l'ancien flux.
model MembershipForm {
  id            String               @id @default(cuid())
  associationId String
  slug          String
  title         String
  status        MembershipFormStatus @default(DRAFT)

  // Étape 1 — Informations générales
  imageUrl             String?
  description          String? // HTML riche
  conditions           String? // HTML riche
  attachments          Json? // [{ url, filename, size }]
  requireCguvSignature Boolean                  @default(false)
  contactEmail         String?
  contactPhone         String?
  // Remplace le premier écran de décision de l'assistant AssoConnect ("Adhésion immédiate" vs
  // "Demande d'adhésion") — devient un simple champ de cette étape. Ne s'applique qu'aux tiers
  // gratuits : un tier payant est toujours IMMEDIATE dès que Stripe confirme le paiement (il
  // n'y a rien de sensé à "mettre en attente" un paiement déjà capturé).
  validationMode       MembershipValidationMode @default(IMMEDIATE)

  // Étape 3 — Formulaire : matrice d'exigence des champs standards
  fieldAddress   MembershipFieldRequirement @default(HIDDEN)
  fieldBirthDate MembershipFieldRequirement @default(HIDDEN)
  fieldPhone     MembershipFieldRequirement @default(HIDDEN)
  fieldMobile    MembershipFieldRequirement @default(HIDDEN)
  fieldGender    MembershipFieldRequirement @default(HIDDEN)
  fieldPhoto     MembershipFieldRequirement @default(HIDDEN)
  fieldLanguage  MembershipFieldRequirement @default(HIDDEN)

  // Étape 4 — Paiement. Pas de champ "allowOnline" (contrairement à DonationForm) : un tier
  // payant passe toujours par Stripe, ces 3 flags n'activent que le règlement hors-ligne des
  // tiers ONE_OFF (encaissement manuel par un admin, comme pour les dons).
  allowCash              Boolean @default(false)
  allowCheque            Boolean @default(false)
  allowTransfer          Boolean @default(false)
  offlineInstructions    String?
  confirmationMessage    String?
  // Optionnel — un admin doit explicitement le renseigner pour recevoir un email à chaque
  // nouvelle adhésion via ce formulaire (voir notifyMembershipSignup). Distinct de
  // contactEmail, qui est montré aux visiteurs comme point de contact, jamais utilisé pour
  // recevoir quoi que ce soit en interne. Sans ce champ, une adhésion réussie ne produit
  // aujourd'hui qu'une ligne dans le journal d'activité — rien de proactif.
  adminNotificationEmail String?

  // Étape 5 — Publication
  visibility    MembershipVisibility @default(LINK)
  // Id of the "membership"-type SiteSection (Association.siteConfig JSON, see
  // src/types/site-config.ts) this form is bound to when visibility = SITE — mirrors
  // AssoConnect's "Sélectionner une page sur laquelle publier le formulaire" step: an explicit
  // form→section pick instead of an implicit "most recently touched SITE form wins" heuristic.
  // Required by the API whenever visibility is set to SITE; null for LINK/PRIVATE.
  siteSectionId String?
  opensAt       DateTime?
  closesAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  association    Association               @relation(fields: [associationId], references: [id], onDelete: Cascade)
  tiers          MembershipTier[]
  products       MembershipFormProduct[]
  customFields   MembershipFormField[]
  cotisations    Cotisation[]
  subscriptions  CotisationSubscription[]
  checkoutDrafts MembershipCheckoutDraft[]

  @@unique([associationId, slug])
  @@index([associationId, status])
}

// Holds a multi-registrant MembershipForm submission (N>1 "Adhérent" blocks in the same
// checkout, see membership-form-public-form.tsx's "Ajouter un autre adhérent") between the
// visitor submitting the form and their payment actually completing. Unlike the single-
// registrant flow, N full identities don't fit in Stripe's metadata (a single person already
// uses ~10 keys — see checkout/route.ts's commonMeta), so this row is what the checkout
// session's metadata.draftId points at instead, and consumeMembershipCheckoutDraft (src/lib/
// webhook/membership-multi.ts) is what turns it into real Membre/Cotisation rows once
// payment is confirmed (or immediately, for an all-free submission — see checkout/route.ts).
model MembershipCheckoutDraft {
  id            String  @id @default(cuid())
  associationId String
  formId        String
  email         String
  // Null when every registrant's tier was free and validationMode routed this to the
  // PENDING-approval path instead of ever reaching this table — see checkout/route.ts.
  passwordHash  String?

  conditionsAgreedAt DateTime?
  termsAcceptedIp    String?
  // [{ tierId, amount?, firstName, lastName, birthDate?, sexe?, phone?, mobile?, address?,
  // answers }] — one entry per "Adhérent" block on the public form, in submission order.
  // registrants[0] is the person who filled the form (gets the User/login); the rest become
  // Membre-only dependants of them (Membre.responsableId) — see consumeMembershipCheckoutDraft.
  registrants        Json
  // [{ v: varianteId, q: quantity }] — Boutique products chosen alongside the group signup,
  // always attributed to registrants[0] (the one person with a real email/login in the
  // submission) once consumed, never split across the group. Same minimal-keys shape as
  // checkout/route.ts's single-registrant commonMeta.products, kept consistent even though
  // this rides in a real Json column (no Stripe metadata size cap to economize for) rather
  // than a stringified value.
  products           Json?
  // [{ tierId, itemType, label, amount, receiptMode, deductibleAmount }] — options payantes et
  // dons embarqués choisis à côté de l'inscription groupée. Même forme que metadata.addons du
  // parcours à un seul adhérent (voir checkout/route.ts), pour que createMembershipAddonPurchases
  // consomme les deux sans distinction. Toujours rattachés à registrants[0], la seule personne
  // du groupe avec un email/login réel — même règle que products ci-dessus.
  addons             Json?
  totalAmount        Decimal   @db.Decimal(10, 2)

  createdAt  DateTime  @default(now())
  // Swept by /api/cron/membership-drafts-sweep once past this without ever being consumed —
  // an abandoned checkout (closed tab, expired Stripe session) shouldn't sit here forever.
  expiresAt  DateTime
  // Set by consumeMembershipCheckoutDraft once the Membre/Cotisation rows exist — both the
  // idempotency guard against a redelivered webhook event and what excludes this row from
  // the sweep above.
  consumedAt DateTime?

  association Association    @relation(fields: [associationId], references: [id], onDelete: Cascade)
  form        MembershipForm @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([associationId])
  @@index([formId])
  @@index([expiresAt])
}

// Palier tarifaire d'un MembershipForm — même rôle que DonationTier. Pas de champ "interval"
// séparé : un tier RECURRING facture toujours tous les durationMonths (12 par défaut), jamais
// un autre découpage (mensuel, trimestriel) — voir durationMonths ci-dessous.
model MembershipTier {
  id       String                 @id @default(cuid())
  formId   String
  order    Int
  kind     MembershipTierKind     @default(ONE_OFF)
  // MEMBERSHIP (default) is a full-fledged adhésion tier, exactly as before this field
  // existed. ADDON forces kind to ONE_OFF and ignores membreTypeId in the admin UI (no
  // recurring add-on, doesn't tag a member category). DONATION forces freeAmount to true and
  // requires amount as a minimum, same UI-level rules as DonationTier's own montant libre.
  itemType MembershipTierItemType @default(MEMBERSHIP)

  // "Gratuit" — ignore freeAmount/amount, aucun passage par Stripe (mutuellement exclusif
  // avec freeAmount).
  free       Boolean  @default(false)
  freeAmount Boolean  @default(false) // « Montant libre »
  // Montant fixe du tarif ; si freeAmount, sert de montant minimum optionnel (null = aucun
  // minimum, seul le plancher générique MIN_ITEM_AMOUNT s'applique) ; null si free.
  amount     Decimal? @db.Decimal(10, 2)

  // null = comportement historique, période = année civile de `Cotisation.year`. Un nombre =
  // adhésion valable durationMonths à partir de la date de paiement plutôt que du 1er janvier
  // — voir Cotisation.periodStart/periodEnd et src/lib/membre-adherent.ts. Seulement pertinent
  // pour itemType MEMBERSHIP ; ignoré (forcé null) pour ADDON/DONATION comme les autres champs
  // propres à l'adhésion elle-même. Mutuellement exclusif avec fixedPeriodEnd ci-dessous.
  durationMonths      Int?
  // Alternative à durationMonths : une date de fin absolue, identique pour tout le monde peu
  // importe la date de paiement (ex. "saison 2026-2027, valable jusqu'au 31 août 2027") plutôt
  // qu'un nombre de mois relatif à l'inscription. Seulement pour un tier ONE_OFF — un tier
  // RECURRING se renouvelle indéfiniment, une date de fin absolue n'a pas de sens pour lui
  // (voir tiers/route.ts pour la validation d'exclusion mutuelle).
  fixedPeriodEnd      DateTime?
  // Un tier MEMBERSHIP peut être marqué éligible au reçu fiscal — rare en France (une
  // cotisation n'est pas un don), mais certaines associations le permettent dans des cas
  // précis, parfois seulement partiellement (ex. une part de la cotisation correspond à une
  // contrepartie — revue, événement — non déductible). Même modèle que DonationTier.
  // receiptMode/ineligibleAmount. Répercuté sur chaque Cotisation qu'il produit (voir
  // Cotisation.receiptMode), jamais réévalué a posteriori si le tier change après coup —
  // même logique de snapshot que membershipFormId/tierId déjà copiés sur Cotisation.
  receiptMode         DonationReceiptMode @default(NONE)
  // Part du montant NON éligible au reçu fiscal — requis si receiptMode = PARTIAL. Le
  // montant éligible imprimé sur le reçu est calculé automatiquement (voir
  // eligibleReceiptAmount dans src/lib/receipt-eligibility.ts) comme (montant réellement
  // payé − ineligibleAmount), jamais stocké tel quel : pour un tarif freeAmount le montant
  // payé n'est connu qu'au moment du paiement.
  ineligibleAmount    Decimal?            @db.Decimal(10, 2)
  // "Payer en plusieurs fois" — offre au visiteur, au moment du paiement, le choix de régler
  // en installmentsCount mensualités automatiques plutôt qu'en une fois. Implémenté comme un
  // Stripe Subscription plafonné à N cycles (subscription_data.cancel_at, voir checkout/
  // route.ts) plutôt qu'une vraie adhésion récurrente — chaque prélèvement s'applique à la
  // MÊME Cotisation (voir CotisationInstallmentPlan), pas une nouvelle par an comme
  // CotisationSubscription. Seulement pour un tier ONE_OFF à montant fixe (pas RECURRING —
  // déjà étalé dans le temps par nature ; pas free/freeAmount, ça ne se divise pas proprement
  // en N parts égales) — voir tiers/route.ts pour la validation.
  installmentsAllowed Boolean             @default(false)
  // Bornée à [2, 12] — 1 fois n'est pas un "plusieurs fois", et au-delà de 12 mensualités le
  // découpage devient peu réaliste pour une cotisation associative.
  installmentsCount   Int?                @default(3)

  label        String
  // Tag automatique du Membre créé par ce tier — remplace le menu déroulant de MembreType
  // aujourd'hui totalement indépendant du prix choisi sur le formulaire public actuel.
  // Seulement pertinent pour itemType MEMBERSHIP.
  membreTypeId String?

  form           MembershipForm            @relation(fields: [formId], references: [id], onDelete: Cascade)
  membreType     MembreType?               @relation(fields: [membreTypeId], references: [id], onDelete: SetNull)
  cotisations    Cotisation[]
  subscriptions  CotisationSubscription[]
  pendingMembres Membre[]
  addonPurchases MembershipAddonPurchase[]
  // Dons produits par ce tier quand itemType == DONATION — voir Don.membershipAddonTierId.
  donsGenerated  Don[]

  @@index([formId])
  @@index([membreTypeId])
}

// Un produit Boutique proposé à la vente en fin de MembershipForm — l'admin choisit
// directement une (ou plusieurs) BoutiqueVariante précise(s), pas un BoutiqueProduit dont
// l'acheteur choisirait ensuite la variante. Pur pointeur d'offre, sans signification
// financière propre : onDelete Cascade (pas Restrict comme BoutiqueCommandeItem) — supprimer
// la variante côté Boutique doit juste arrêter de la proposer ici, jamais bloquer sa
// suppression. Voir membership-form-products.ts pour l'achat effectif (BoutiqueCommande).
model MembershipFormProduct {
  id         String   @id @default(cuid())
  formId     String
  varianteId String
  order      Int
  createdAt  DateTime @default(now())

  form     MembershipForm   @relation(fields: [formId], references: [id], onDelete: Cascade)
  variante BoutiqueVariante @relation(fields: [varianteId], references: [id], onDelete: Cascade)

  @@unique([formId, varianteId])
  @@index([formId])
}

// Mirroir exact de MembershipFormProduct, côté Eventos — pur pointeur "quel variante est
// proposé à cet évènement", jamais référencé par un BoutiqueCommandeItem (celui-ci pointe
// directement sur varianteId), donc supprimable/recréable librement à chaque sauvegarde.
model EvenementProduct {
  id          String   @id @default(cuid())
  evenementId String
  varianteId  String
  order       Int
  createdAt   DateTime @default(now())

  evenement Evenement        @relation(fields: [evenementId], references: [id], onDelete: Cascade)
  variante  BoutiqueVariante @relation(fields: [varianteId], references: [id], onDelete: Cascade)

  @@unique([evenementId, varianteId])
  @@index([evenementId])
}

// Un achat d'option ADDON réglé au moment d'une adhésion — séparé de Cotisation.amount pour
// que ce dernier continue de représenter uniquement le prix de l'adhésion elle-même (pas la
// somme adhésion+options), afin de ne pas fausser les rapports financiers déjà construits sur
// cette hypothèse. cotisationId est nullable : un ADDON peut accompagner une adhésion gratuite
// (Cotisation.amount = 0) sans que l'achat lui-même soit gratuit.
model MembershipAddonPurchase {
  id            String   @id @default(cuid())
  associationId String
  membreId      String
  tierId        String
  cotisationId  String?
  label         String // snapshot du MembershipTier.label au moment de l'achat
  amount        Decimal  @db.Decimal(10, 2)
  purchasedAt   DateTime @default(now())

  association Association    @relation(fields: [associationId], references: [id], onDelete: Cascade)
  membre      Membre         @relation(fields: [membreId], references: [id], onDelete: Cascade)
  tier        MembershipTier @relation(fields: [tierId], references: [id], onDelete: Cascade)
  cotisation  Cotisation?    @relation(fields: [cotisationId], references: [id], onDelete: SetNull)

  @@index([membreId])
  @@index([associationId])
}

// Champ personnalisé par formulaire, répondu via Membre.answers — même mécanisme que
// DonationFormField / Don.answers.
model MembershipFormField {
  id       String              @id @default(cuid())
  formId   String
  type     MembershipFieldType
  label    String
  required Boolean             @default(false)
  order    Int

  form MembershipForm @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId])
}

// Un don récurrent Stripe. Chaque prélèvement réussi produit une ligne Don rattachée ici
// (Don.subscriptionId) — le reçu fiscal annuel est une agrégation des Don d'un abonnement,
// pas un chemin parallèle. Connect est utilisé ici en destination charges : le Customer et
// la Subscription vivent sur le compte plateforme, pas sur celui de l'association — d'où la
// discrimination obligatoire par subscription_data.metadata.kind dans le webhook (voir
// src/app/api/webhook/stripe/route.ts) avant tout traitement en tant qu'abonnement Formwise.
model DonationSubscription {
  id             String @id @default(cuid())
  associationId  String
  donationFormId String
  tierId         String

  stripeSubscriptionId String  @unique
  stripeCustomerId     String
  // Self-service cancellation link emailed at subscription start — same convention as
  // Participation.cancelToken (donors have no portal account to authenticate an
  // in-app cancel action with).
  cancelToken          String? @unique

  donorType        DonorType            @default(INDIVIDUAL)
  firstName        String
  lastName         String
  companyName      String?
  siret            String?
  email            String
  address          String?
  // Carried from the checkout form onto every Don an invoice.paid event produces for
  // this subscription — same fields a one-off Don would have captured at checkout.
  message          String?
  anonymous        Boolean              @default(false)
  answers          Json?
  // Proof of consent captured at checkout, carried onto every Don this subscription
  // produces — same rationale as Don.cguvAgreedAt.
  cguvAgreedAt     DateTime?
  // Snapshotted from DonationTier at subscription start and carried onto every Don an
  // invoice.paid event produces — same rationale as Don.receiptMode/ineligibleAmount, but
  // more pressing here since a subscription can outlive tier edits by months or years.
  receiptMode      DonationReceiptMode?
  deductibleAmount Decimal?             @db.Decimal(10, 2)

  amount   Decimal          @db.Decimal(10, 2)
  interval DonationInterval

  status DonationSubscriptionStatus @default(ACTIVE)

  startedAt           DateTime  @default(now())
  cancelledAt         DateTime?
  currentPeriodEndsAt DateTime?

  association  Association  @relation(fields: [associationId], references: [id], onDelete: Cascade)
  donationForm DonationForm @relation(fields: [donationFormId], references: [id])
  tier         DonationTier @relation(fields: [tierId], references: [id])
  dons         Don[]

  @@index([associationId, status])
  @@index([donationFormId])
}

// A member's recurring annual cotisation, paid via Stripe — same role as
// DonationSubscription → Don above, but tied to an existing Membre instead of a
// free-floating donor identity (the member already exists via the public site's paid
// membership form; see /api/public/[slug]/inscription/checkout and
// src/lib/webhook/cotisation-subscriptions.ts). Each successful yearly charge produces
// one Cotisation row (Cotisation.subscriptionId), same pattern as Don.subscriptionId.
model CotisationSubscription {
  id            String @id @default(cuid())
  associationId String
  membreId      String @unique // one active recurring subscription per member

  stripeSubscriptionId String  @unique
  stripeCustomerId     String
  // Self-service cancellation link, same convention as DonationSubscription.cancelToken —
  // kept even though the member also gets portal access, as a no-login-required fallback.
  cancelToken          String? @unique

  amount Decimal                      @db.Decimal(10, 2)
  status CotisationSubscriptionStatus @default(ACTIVE)

  startedAt           DateTime  @default(now())
  cancelledAt         DateTime?
  currentPeriodEndsAt DateTime?

  // Reporting-only link to whichever MembershipForm/MembershipTier started this recurring
  // subscription — null for one created any other way (legacy /inscription/checkout, admin).
  // Copied onto every yearly Cotisation this subscription produces (see
  // handleCotisationInvoicePaid) since a Cotisation row, not this row, is what the
  // MembershipForm list page's "total collected" figure actually sums.
  membershipFormId String?
  tierId           String?
  // Snapshotted from MembershipTier.durationMonths at signup — same reasoning as
  // membershipFormId/tierId already being snapshots: the tier can change later without
  // affecting an already-running subscription. Null = ordinary yearly billing (Stripe
  // `interval: "year"`); a number = `interval_count` months instead (see checkout/route.ts
  // and handleCotisationInvoicePaid, src/lib/webhook/cotisation-subscriptions.ts).
  durationMonths   Int?
  // Snapshotted from MembershipTier.receiptMode/ineligibleAmount at signup, same reasoning as
  // durationMonths above — copied onto every yearly Cotisation this subscription produces
  // (see handleCotisationInvoicePaid) so a tier edited after signup can't change what an
  // already-running subscription's past or future receipts are eligible for.
  receiptMode      DonationReceiptMode @default(NONE)
  deductibleAmount Decimal?            @db.Decimal(10, 2)

  association    Association     @relation(fields: [associationId], references: [id], onDelete: Cascade)
  membre         Membre          @relation(fields: [membreId], references: [id])
  membershipForm MembershipForm? @relation(fields: [membershipFormId], references: [id], onDelete: SetNull)
  tier           MembershipTier? @relation(fields: [tierId], references: [id], onDelete: SetNull)
  cotisations    Cotisation[]

  @@index([associationId, status])
  @@index([membershipFormId])
  @@index([tierId])
}

model Notification {
  id        String            @id @default(cuid())
  userId    String
  title     String
  body      String?
  link      String?
  scope     NotificationScope @default(MEMBRE)
  read      Boolean           @default(false)
  createdAt DateTime          @default(now())
  // High-volume, repeatable events (e.g. one sondage response after another) reuse the
  // same unread row instead of creating a new one each time — see notifyAdminsOfResponse
  // in src/app/api/portal/sondages/[id]/repondre/route.ts. Left null for every other
  // notification type, which still gets one row per event as before.
  groupKey  String?
  count     Int               @default(1)

  user User @relation(fields: [userId], references: [id])

  @@index([userId, read])
  @@index([userId, scope, read])
  @@index([userId, groupKey, read])
}

// Two-way support channel between an association's own ADMIN and the platform's SUPER_ADMIN
// team — see src/lib/support-tickets.ts. `readByStaffAt`/`readByAssociationAt` are single
// shared timestamps rather than a per-user read table: only one ADMIN can ever write from
// the association side (see SupportTicketMessage.authorId), and every SUPER_ADMIN shares one
// "has staff looked at this" state, so there's no real many-to-many read state to track.
model SupportTicket {
  id                    String              @id @default(cuid())
  associationId         String
  authorId              String
  subject               String
  status                SupportTicketStatus @default(OUVERT)
  // Denormalized off the latest SupportTicketMessage so the inbox can sort/filter without a
  // join, and so unread state is a plain timestamp comparison — see deriveTicketUnread in
  // src/lib/support-tickets.ts.
  lastMessageAt         DateTime            @default(now())
  lastMessageAuthorRole UserRole
  readByStaffAt         DateTime?
  readByAssociationAt   DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

